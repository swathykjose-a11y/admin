# =============================================================================
# Dainty Dazzle - Admin Dashboard Environment Variables
# Copy this file to .env.local and fill in real values.
# =============================================================================

# Server API URL (Hono Node.js backend - read server-side only, never NEXT_PUBLIC)
SERVER_URL=https://api.daintydazzle.store

# Admin Secret Key for API authorization (matches ADMIN_API_KEY in server - pure server-side)
ADMIN_API_KEY=your-secure-admin-secret-key-32-chars
